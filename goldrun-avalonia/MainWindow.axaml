<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GoldRun.Controls"
        x:Class="GoldRun.MainWindow"
        Title="GoldRun"
        Width="420" Height="640"
        CanResize="False"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Window.Styles>
    <!-- 卡片 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#0FFFFFFF" />
      <Setter Property="BorderBrush" Value="#14FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <!-- Tab 按钮 -->
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#8B90A0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="0,7" />
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="Background" Value="#0FFFFFFF" />
      <Setter Property="Foreground" Value="#E8EAF0" />
    </Style>
    <!-- 区间按钮 -->
    <Style Selector="Button.range">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#8B90A0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="0,4" />
    </Style>
    <Style Selector="Button.range.active">
      <Setter Property="Background" Value="#334F8EF7" />
      <Setter Property="Foreground" Value="#4F8EF7" />
    </Style>
    <!-- 文本 -->
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#8B90A0" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="Foreground" Value="#E8EAF0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.sub">
      <Setter Property="Foreground" Value="#8B90A0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="ProgressBar.meter">
      <Setter Property="Height" Value="5" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="Foreground" Value="#4F8EF7" />
      <Setter Property="Maximum" Value="1" />
    </Style>
  </Window.Styles>

  <Border Background="#F5181A20" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12">
    <DockPanel>
      <!-- 顶部 Tab -->
      <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="12,10,12,6">
        <Button x:Name="SystemTabButton" Classes="tab active" Content="系统监控" Click="OnSystemTabClicked" Margin="0,0,2,0" />
        <Button x:Name="GoldTabButton" Classes="tab" Content="金价分析" Click="OnGoldTabClicked" Margin="2,0,0,0" />
      </UniformGrid>

      <!-- 底部状态 -->
      <Border DockPanel.Dock="Bottom" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="12,6">
        <TextBlock x:Name="FooterStatus" Text="GoldRun for Windows (Avalonia)" FontSize="11"
                   Foreground="#8B90A0" HorizontalAlignment="Center" />
      </Border>

      <!-- 系统监控页 -->
      <ScrollViewer x:Name="SystemPage">
        <StackPanel Margin="12,0,12,10" Spacing="8">
          <Border Classes="card">
            <StackPanel>
              <DockPanel>
                <TextBlock Classes="label" Text="CPU" />
                <TextBlock x:Name="CpuUsageText" Classes="value" Text="--%" HorizontalAlignment="Right" />
              </DockPanel>
              <ProgressBar x:Name="CpuBar" Classes="meter" />
              <TextBlock x:Name="CpuDetailText" Classes="sub" Text="-- 核心" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <DockPanel>
                <TextBlock Classes="label" Text="内存" />
                <TextBlock x:Name="MemUsageText" Classes="value" Text="--%" HorizontalAlignment="Right" />
              </DockPanel>
              <ProgressBar x:Name="MemBar" Classes="meter" />
              <TextBlock x:Name="MemDetailText" Classes="sub" Text="-- / --" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <DockPanel>
                <TextBlock Classes="label" Text="磁盘" />
                <TextBlock x:Name="DiskUsageText" Classes="value" Text="--%" HorizontalAlignment="Right" />
              </DockPanel>
              <ProgressBar x:Name="DiskBar" Classes="meter" />
              <TextBlock x:Name="DiskDetailText" Classes="sub" Text="-- / --" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock Classes="label" Text="网络" />
                <TextBlock x:Name="NetSpeedText" Classes="value" FontSize="12.5" Text="↓ --  ↑ --" HorizontalAlignment="Right" />
              </DockPanel>
              <DockPanel>
                <TextBlock Classes="label" Text="开机时长" />
                <TextBlock x:Name="UptimeText" Classes="value" FontSize="12.5" Text="--" HorizontalAlignment="Right" />
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- 金价分析页 -->
      <ScrollViewer x:Name="GoldPage" IsVisible="False">
        <StackPanel Margin="12,0,12,10" Spacing="8">
          <Border Classes="card">
            <DockPanel>
              <StackPanel>
                <TextBlock x:Name="GoldPriceText" Text="--" FontSize="26" FontWeight="ExtraBold" Foreground="#E8B34B" />
                <TextBlock x:Name="GoldUpdatedText" Classes="sub" Text="--" />
              </StackPanel>
              <TextBlock x:Name="GoldChangeText" Text="--" FontSize="14" FontWeight="Bold"
                         Foreground="#8B90A0" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <UniformGrid x:Name="RangeSelector" Columns="6" Margin="0,0,0,8">
                <Button Classes="range active" Content="1D" Tag="today" Click="OnRangeClicked" />
                <Button Classes="range" Content="1W" Tag="w" Click="OnRangeClicked" />
                <Button Classes="range" Content="1M" Tag="m" Click="OnRangeClicked" />
                <Button Classes="range" Content="3M" Tag="q" Click="OnRangeClicked" />
                <Button Classes="range" Content="6M" Tag="h" Click="OnRangeClicked" />
                <Button Classes="range" Content="1Y" Tag="y" Click="OnRangeClicked" />
              </UniformGrid>
              <controls:PriceChart x:Name="Chart" Height="160" />
              <DockPanel Margin="0,4,0,0">
                <TextBlock x:Name="ChartStartText" Classes="sub" Text="--" Margin="0" />
                <TextBlock x:Name="ChartEndText" Classes="sub" Text="--" Margin="0" HorizontalAlignment="Right" />
              </DockPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <TextBlock Classes="sub" Text="技术指标" Margin="0,0,0,8" FontWeight="SemiBold" />
              <UniformGrid x:Name="IndicatorGrid" Columns="2" />
              <TextBlock x:Name="TechHintText" Classes="sub" Text="--" Margin="0,8,0,0" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <TextBlock Classes="sub" Text="多平台金价" Margin="0,0,0,8" FontWeight="SemiBold" />
              <StackPanel x:Name="MultiSourceList" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
